# --- LLM providers (the agents that direct the music video) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Map the arena's display names to real provider model ids.
# Defaults are placeholders - set these to the models you actually have access to.
SOL_MODEL_ID=gpt-5.6-sol
FABLE_MODEL_ID=claude-fable-5

# Optional: USD per 1M input/output tokens, used to compute the LLM token cost in
# the run summary. Leave unset to skip token-cost accounting.
SOL_IN_PER_1M=
SOL_OUT_PER_1M=
FABLE_IN_PER_1M=
FABLE_OUT_PER_1M=

# --- Generation providers (the models pick from these) ---
FAL_KEY=
REPLICATE_API_TOKEN=

# --- Web search (optional; the model can also curl via run_command) ---
TAVILY_API_KEY=

# --- Run settings (optional; CLI flags override these) ---
BUDGET_USD=25
MAX_STEPS=200
WALL_CLOCK_MS=7200000
